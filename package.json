{
  "name": "open-gajae",
  "version": "0.1.3",
  "type": "module",
  "description": "OpenCode plugin that takes coding work from a vague idea to verified changes with three skills: deep-interview (clarify), ralplan (plan) and ultragoal (execute)",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donghae0414/open-gajae.git"
  },
  "homepage": "https://github.com/donghae0414/open-gajae#readme",
  "bugs": {
    "url": "https://github.com/donghae0414/open-gajae/issues"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./dist/tui.js",
    "./rpc": "./src/todo/protocol.ts"
  },
  "bin": {
    "open-gajae": "bin/open-gajae.mjs"
  },
  "files": [
    "bin",
    "dist/tui.js",
    "index.ts",
    "tui.ts",
    "src",
    "skills",
    "prompts",
    "licenses",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build:tui": "bun ./scripts/build-tui.ts",
    "prepack": "bun run build:tui",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests",
    "test:interleavings": "TODO_INTERLEAVINGS_FULL=1 bun test ./tests/todo-interleavings.test.ts",
    "test:host:todo": "bun ./tests/host-todo-probe.ts",
    "test:host:todo:tui": "bun ./tests/host-todo-tui-probe.ts",
    "test:host": "bun ./tests/host-probe.ts && bun ./tests/host-session-probe.ts && bun ./tests/planner-permission-probe.ts && bun ./tests/package-probe.ts && bun ./tests/ralplan-trail-probe.ts"
  },
  "dependencies": {
    "@ast-grep/napi": "0.31.1",
    "@opencode/plugin": "2.0.26",
    "jsonc-parser": "3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@opencode/theme": "2.0.26",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/bun": "^1.3.0",
    "solid-js": "1.9.12",
    "typescript": "^5.9.3"
  }
}
